{
  "name": "stock-watch-ext",
  "version": "1.1.0",
  "description": "盯盘助手 - Chrome MV3 实时行情盯盘插件",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "e2e": "npm run build && node e2e/run.mjs",
    "e2e:headed": "npm run build && node e2e/run.mjs --headed",
    "shots": "npm run build && node e2e/shots.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "esbuild": "^0.23.0",
    "puppeteer-core": "^25.3.0",
    "typescript": "^5.5.0"
  }
}
